rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Consultations collection (Public submission, client & admin review)
    match /consultations/{consultationId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Diagnostics collection (Diagnostic Gateway 75 / 99)
    match /diagnostics/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // CRM Leads collection (Kanban funnel)
    match /crm_leads/{leadId} {
      allow create, read, update, delete: if true;
    }

    // Sovereign Admins & Executive Leadership
    match /sovereign_admins/{adminId} {
      allow create, read, update, delete: if true;
    }

    // Client evaluations & diagnostic audit logs
    match /client_evaluations/{evalId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Default fallback rule
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
